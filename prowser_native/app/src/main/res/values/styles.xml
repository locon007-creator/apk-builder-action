<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/prowser_bg</item>
        <item name="android:navigationBarColor">@color/prowser_bg</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:colorAccent">@color/prowser_accent</item>
    </style>
    <style name="AppTheme.Splash" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@drawable/splash_screen</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/prowser_bg</item>
        <item name="android:navigationBarColor">@color/prowser_bg</item>
    </style>
</resources>
